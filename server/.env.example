# REQUIRED outside of deliberately local development
EASYKIG_SERVER_TOKEN=choose-a-long-random-token
# Only for tests on a trusted machine, never expose publicly:
EASYKIG_ALLOW_UNAUTHENTICATED=0
# Optional image edit provider:
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_API_BASE=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional comma-separated model IDs that clients may select in Blender
EASYKIG_IMAGE_MODELS=
# Optional key from the OpenAI project in your API-credit-linked organization
OPENAI_SUBSCRIPTION_API_KEY=
# Optional directory of UTF-8 files head.txt, design.txt and product.txt
EASYKIG_REFERENCE_PROMPTS_DIR=
# Optional service to edit GLB meshes (POST JSON -> GLB base64 JSON):
EASYKIG_EDIT3D_UPSTREAM_URL=
EASYKIG_EDIT3D_UPSTREAM_TOKEN=
