# token: Bearer authentication; ssh: loopback-only gateway reached through SSH
EASYKIG_AUTH_MODE=token
# Required in token mode
EASYKIG_SERVER_TOKEN=choose-a-long-random-token
# Only for tests on a trusted machine, never expose publicly:
EASYKIG_ALLOW_UNAUTHENTICATED=0
EASYKIG_HOST=127.0.0.1
EASYKIG_PORT=8001
# Optional image edit provider:
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_API_BASE=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional comma-separated model IDs that clients may select in Blender
EASYKIG_IMAGE_MODELS=
# Optional key from the OpenAI project in your API-credit-linked organization
OPENAI_SUBSCRIPTION_API_KEY=
# Optional directory of UTF-8 files head.txt, design.txt and product.txt
EASYKIG_REFERENCE_PROMPTS_DIR=
# generic: legacy POST JSON -> GLB base64 JSON; shapeup: image-conditioned async jobs
EASYKIG_EDIT3D_BACKEND=generic
# With shapeup, use the service root, for example http://127.0.0.1:8000
EASYKIG_EDIT3D_UPSTREAM_URL=
EASYKIG_EDIT3D_UPSTREAM_TOKEN=
# Optional server-side token file; used only if the inline token is empty
EASYKIG_EDIT3D_UPSTREAM_TOKEN_FILE=
# Persist bbox restoration metadata so Blender can resume after reconnecting
EASYKIG_EDIT3D_JOB_DIR=runtime/edit3d-jobs
